{
  "Mqtt": {
    "Port": 1883,
    "TlsPort": 8883,
    "EnableTls": false,
    "CertificatePath": "certs/broker.pfx",
    "CertificatePassword": "",
    "ConnectionBacklog": 100,
    "MaxConnections": 500,
    "PersistentSessions": true,
    "WebSocket": {
      "Enable": true,
      "Port": 8080,
      "Path": "/mqtt",
      "EnableTls": false,
      "TlsPort": 8081
    }
  },
  "Auth": {
    "Mode": "Anonymous",
    "AnonymousRoles": [ "anonymous" ],
    "Users": []
  },
  "Acl": {
    "anonymous": [
      {
        "TopicPattern": "#",
        "Publish": true,
        "Subscribe": true
      },
      {
        "TopicPattern": "$SYS/#",
        "Publish": false,
        "Subscribe": true
      }
    ]
  },
  "Security": {
    "MaxFailedAttemptsPerIp": 5,
    "LockoutDurationSeconds": 60
  }
}