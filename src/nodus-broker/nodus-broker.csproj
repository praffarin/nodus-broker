<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ApplicationIcon>icons\app.ico</ApplicationIcon>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
        <AspNetCoreModuleName>UnmanagedHostingModule</AspNetCoreModuleName>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>nodus-broker</AssemblyName>
        <Version>0.1.0</Version>
        <InformationalVersion>$(Version)</InformationalVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Copyright>Copyright © nodus-broker Contributors 2026-$([System.DateTime]::Now.ToString(yyyy))</Copyright>
        <Description>MQTT Broker</Description>
        <Product></Product>
        <AssemblyTitle>$(AssemblyName)</AssemblyTitle>
        <NeutralLanguage>en</NeutralLanguage>
        <RestoreSources>nupkg</RestoreSources>
        <RestoreSources Condition=" '$(EnableNuGetSource)' != 'false' ">$(RestoreSources);https://api.nuget.org/v3/index.json</RestoreSources>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\$(AssemblyName).xml</DocumentationFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
        <DebugType>embedded</DebugType>
    </PropertyGroup>
    <Target Name="DeleteInProcessDllAfterPublish" AfterTargets="Publish">
        <Delete Files="$(PublishDir)aspnetcorev2_inprocess.dll" ContinueOnError="true" />
    </Target>
    <ItemGroup>
        <FrameworkReference Remove="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
        <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
        <PackageReference Include="MQTTnet.AspNetCore" Version="5.2.0.1603" />
    </ItemGroup>
    <Target Name="cleanBinObj" BeforeTargets="restore">
        <!-- Remove obj folder -->
        <RemoveDir Directories="$(BaseIntermediateOutputPath)" />
        <!-- Remove bin folder -->
        <RemoveDir Directories="$(BaseOutputPath)" />
        <!-- Remove Publish folder -->
        <RemoveDir Directories="$(PublishDir)" />
    </Target>
</Project>