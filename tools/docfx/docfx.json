{
  "metadata": [
    {
      "src": [
        {
          "files": ["src/nodus-broker/**/*.csproj", "src/bg-nodus-broker/**/*.csproj", "tools/PasswordHashGenerator/**/*.csproj"],
          "src": "../../"
        }
      ],
      "dest": "./generated/api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": { "TargetFramework": "net9.0" }
    }
  ],
  "build": {
    "content": [
      {
        "src": "./generated",
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "src": "../../doc",
        "files": ["articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md"]
      }
    ],
    "resource": [
      {
        "src": "../../doc",
        "files": ["img/**", "images/**"]
      }
    ],
    "overwrite": [

    ],
    "dest": "../../doc/_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": ["default", "modern"],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appTitle": "Documentation Broker MQTT nodus-broker",
      "_appName": "nodus-broker",
      "_appFooter": "<span>Copyright © 2026 Raffarin Pascal. Licensed under the <a href=\"https://opensource.org/licenses/MIT\">MIT License</a>.</span>",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": true,
      "_disableBreadcrumb": false,
      "pdf": false,
      "pdfTocPage": false
    },
    "fileMetadata": {
      "_disableContribution": { "api/**.yml": true }
    }
  }
}
